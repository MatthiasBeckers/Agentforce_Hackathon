<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_to_output_variable</name>
        <label>Assign to output variable</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>output_timesheet_entries</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Time_Sheet_Entry</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Service_Resource_found</name>
        <label>Service Resource found?</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_SR_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_own_Service_Resource.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_Time_Sheet</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Time_Sheet_found</name>
        <label>Time Sheet found?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_ts_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_Time_Sheet.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Time_Sheet_Entry</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Select a Timesheet Entry from the input_date and the input_type. If now entry is found, null is returned. If a entry is found the list of Time sheet entries is returned.</description>
    <environments>Default</environments>
    <formulas>
        <name>input_date_beginning</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!input_date}) + &apos; 00:00:00&apos;)</expression>
    </formulas>
    <formulas>
        <name>input_date_ending</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!input_date}) + &apos; 23:00:00&apos;)</expression>
    </formulas>
    <interviewLabel>Timesheet: Get Entry from Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Timesheet: Get Entry from Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Time_Sheet_Entry</name>
        <label>Get Time Sheet Entry</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_to_output_variable</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TimeSheetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Select_Time_Sheet.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartTime</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>input_date_beginning</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartTime</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>input_date_ending</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>input_type</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>TimeSheetEntry</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Select_own_Service_Resource</name>
        <label>Select own Service Resource</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Service_Resource_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RelatedRecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ServiceResource</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Select_Time_Sheet</name>
        <label>Select Time Sheet</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Time_Sheet_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ServiceResourceId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Select_own_Service_Resource.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>EndDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>input_date</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>input_date</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TimeSheet</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Select_own_Service_Resource</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The date to select the time entries. Datatype is Date MM/DD/YYYY</description>
        <name>input_date</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Type of the time sheet entry. Types are: Work or Break.</description>
        <name>input_type</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The selected Timesheet Entries as a list. If no records are found null is returned</description>
        <name>output_timesheet_entries</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>TimeSheetEntry</objectType>
    </variables>
</Flow>
